#!/bin/bash
# Runs one heavy command (test suite, build, init.sh) while holding the Loop's machine-wide lock,
# so parallel Workers never build at the same time. bash 3.2 compatible.
#
#   loop-heavy <command> [args...]
#
# Waits up to 60 minutes for the lock. A lock older than 90 minutes is stale and is taken over.
set -u

LOCK="${LOOP_DIR:-$HOME/loop}/state/heavy.lock"
[ $# -gt 0 ] || { echo "usage: loop-heavy <command> [args...]" >&2; exit 2; }
mkdir -p "$(dirname "$LOCK")"

waited=0
until mkdir "$LOCK" 2>/dev/null; do
  if [ -n "$(find "$LOCK" -maxdepth 0 -mmin +90 2>/dev/null)" ]; then
    rmdir "$LOCK" 2>/dev/null
    continue
  fi
  [ "$waited" -ge 3600 ] && { echo "loop-heavy: lock busy for 60 minutes ($LOCK)" >&2; exit 75; }
  [ "$waited" -eq 0 ] && echo "loop-heavy: waiting for another Worker's heavy command" >&2
  sleep 15
  waited=$((waited + 15))
done
trap 'rmdir "$LOCK" 2>/dev/null' EXIT INT TERM

"$@"
