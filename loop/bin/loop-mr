#!/bin/bash
set -u

LOOP_DIR="${LOOP_DIR:-$HOME/loop}"
STATE="$LOOP_DIR/bin/loop-state"
CONFIG="$LOOP_DIR/config.sh"
[ -f "$CONFIG" ] && . "$CONFIG"
LABELS="${LOOP_MR_LABELS:-needs:human-verify}"

usage() {
  cat >&2 <<'USAGE'
loop-mr opens the MR of a Loop task, ready and not a Draft, or replaces the description of the one its branch already has.

  loop-mr <task> [e2e]
  loop-mr <task> e2e-done

Run it in the task's worktree. It reads $LOOP_DIR/state/mr-body-<task>.md:
line 1 is "# <MR title>", the rest is the description in this shape:

  ## Why            the problem and the approach, from the user's side
  ## What changed   a few bullets and a fenced diagram, tree or diff sketch
  ## Scope          what it covers and what it leaves out
  ## Tradeoffs      optional: a table of where the options differed, what was chosen and why
  ## Blast Radius   **Door:** one-way or two-way, and who or what it touches
  ## Verification   **Before:** and **After:** with real output or screenshots

"e2e" adds the label needs:e2e. A body that misses a part is refused and nothing is sent.
"e2e-done" only removes needs:e2e from the task's open MR. It reads the branch from
loop-state, so it runs from any folder.
USAGE
  exit 2
}

die() { echo "loop-mr: $*" >&2; exit 1; }
line_of() { grep -n -m1 -- "$1" "$BODY" | cut -d: -f1; }

check_body() {
  local why changed scope blast verification
  [ -n "$TITLE" ] || die "$FILE line 1 must be '# <MR title>'"
  why=$(line_of '^## Why$')
  changed=$(line_of '^## What changed$')
  scope=$(line_of '^## Scope$')
  blast=$(line_of '^## Blast Radius$')
  verification=$(line_of '^## Verification$')
  [ -n "$why" ] && [ -n "$changed" ] && [ -n "$scope" ] && [ -n "$blast" ] && [ -n "$verification" ] \
    || die "the description needs '## Why', '## What changed', '## Scope', '## Blast Radius' and '## Verification'"
  [ "$why" -lt "$changed" ] && [ "$changed" -lt "$scope" ] && [ "$scope" -lt "$blast" ] && [ "$blast" -lt "$verification" ] \
    || die "the sections go in the order Why, What changed, Scope, Blast Radius, Verification"
  sed -n "${changed},${scope}p" "$BODY" | grep -q '^```' \
    || die "What changed needs a fenced diagram, tree or diff sketch"
  sed -n "${blast},${verification}p" "$BODY" | grep -q '\*\*Door:\*\* *\(one-way\|two-way\)' \
    || die "Blast Radius needs '**Door:** one-way' or '**Door:** two-way'"
  sed -n "${verification},\$p" "$BODY" | grep -q '\*\*Before:\*\*' \
    || die "Verification needs a '**Before:**' line"
  sed -n "${verification},\$p" "$BODY" | grep -q '\*\*After:\*\*' \
    || die "Verification needs an '**After:**' line"
}

mr_field() {
  glab mr view "$BRANCH" ${HOST[@]+"${HOST[@]}"} -F json 2>/dev/null | python3 -I -c '
import json, sys
try:
    mr = json.load(sys.stdin)
except ValueError:
    sys.exit(1)
if mr.get("state") != "opened":
    sys.exit(1)
value = mr.get(sys.argv[1])
print(",".join(value) if isinstance(value, list) else value)' "$1"
}

mr_url() {
  local iid
  [ -n "${!HOST_VAR:-}" ] || { mr_field web_url; return; }
  iid=$(mr_field iid) || return 1
  echo "https://${!HOST_VAR}/-/merge_requests/$iid"
}

resolve_repo() {
  REPO=$("$STATE" get "$TASK" repo) || die "$TASK has no loop-state (repo unknown)"
  read -r _ BASE < <("$STATE" repo "$REPO") || die "unknown repo '$REPO'"
  HOST=()
  HOST_VAR="LOOP_GLAB_REPO_$(echo "$REPO" | tr -c 'A-Za-z0-9\n' '_')"
  [ -n "${!HOST_VAR:-}" ] && HOST=(-R "${!HOST_VAR}")
}

create_mr() {
  [ -n "${!HOST_VAR:-}" ] || {
    glab mr create --yes --source-branch "$BRANCH" --target-branch "$BASE" \
      --title "$TITLE" --description "$(cat "$BODY")" --label "$LABELS" >/dev/null
    return
  }
  local host="${!HOST_VAR%%/*}" project="${!HOST_VAR#*/}" payload status
  payload=$(mktemp)
  python3 -I -c '
import json, sys
branch, base, title, body, labels = sys.argv[1:]
print(json.dumps({"source_branch": branch, "target_branch": base, "title": title,
                  "description": open(body).read(), "labels": labels}))' \
    "$BRANCH" "$BASE" "$TITLE" "$BODY" "$LABELS" > "$payload"
  glab api "projects/${project//\//%2F}/merge_requests" --hostname "$host" --method POST \
    --header "Content-Type: application/json" --input "$payload" >/dev/null
  status=$?
  rm -f "$payload"
  return "$status"
}

remove_e2e_label() {
  resolve_repo
  BRANCH=$("$STATE" get "$TASK" branch)
  [ -n "$BRANCH" ] || die "$TASK has no branch in loop-state"
  IID=$(mr_field iid) || die "$BRANCH has no open MR"
  glab mr update "$IID" ${HOST[@]+"${HOST[@]}"} --unlabel needs:e2e >/dev/null || die "could not update MR !$IID"
  case ",$(mr_field labels)," in *",needs:e2e,"*) die "the MR of $BRANCH still has needs:e2e" ;; esac
  echo "needs:e2e removed from $(mr_url)"
}

[ $# -ge 1 ] && [ $# -le 2 ] || usage
TASK="$1"
case "$TASK" in ""|*/*|.*) die "bad task key '$TASK'" ;; esac
case "${2:-}" in
  "") ;;
  e2e) LABELS="$LABELS,needs:e2e" ;;
  e2e-done) remove_e2e_label; exit 0 ;;
  *) usage ;;
esac

FILE="$LOOP_DIR/state/mr-body-$TASK.md"
[ -s "$FILE" ] || die "$FILE is missing or empty"
TITLE=$(sed -n '1s/^# *//p' "$FILE")
BODY=$(mktemp)
trap 'rm -f "$BODY"' EXIT
tail -n +2 "$FILE" | sed '/./,$!d' > "$BODY"
check_body

resolve_repo
BRANCH=$(git branch --show-current)
case "$BRANCH" in
  ""|"$BASE"|main|master|staging|develop|production) die "refusing to open an MR from '${BRANCH:-detached HEAD}'" ;;
esac

if IID=$(mr_field iid); then
  glab mr update "$IID" ${HOST[@]+"${HOST[@]}"} --ready --title "$TITLE" --description "$(cat "$BODY")" --label "$LABELS" >/dev/null \
    || die "could not update MR !$IID"
else
  create_mr || die "could not open the MR for $BRANCH"
fi

[ "$(mr_field draft)" = False ] || die "the MR of $BRANCH is still a Draft"
SET_LABELS=",$(mr_field labels),"
for LABEL in ${LABELS//,/ }; do
  case "$SET_LABELS" in *",$LABEL,"*) ;; *) die "the MR of $BRANCH lacks the label $LABEL" ;; esac
done
mr_url
