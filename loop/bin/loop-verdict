#!/bin/bash
set -u

LOOP_DIR="${LOOP_DIR:-$HOME/loop}"
STATE="$LOOP_DIR/bin/loop-state"
[ -f "$LOOP_DIR/config.sh" ] && . "$LOOP_DIR/config.sh"

usage() {
  cat >&2 <<'USAGE'
loop-verdict owns the verifier's verdict on a Loop task's pushed branch.

  loop-verdict <task> <PASS|PASS+NOTES|FAIL> <notes file>   record the verdict and post it on the task's MR
  loop-verdict <task> check                                 print "current <verdict>", "stale <verdict>" or "none"

A verdict covers one patch: the diff of origin/<branch> against its fork point from origin/<base>.
A rebase that keeps the patch keeps the verdict; any change to the patch makes it stale.
Only an agent that did not write the code records one.
USAGE
  exit 2
}

die() { echo "loop-verdict: $*" >&2; exit 1; }

resolve_task() {
  REPO=$("$STATE" get "$TASK" repo) || die "$TASK has no loop-state"
  BRANCH=$("$STATE" get "$TASK" branch)
  [ -n "$BRANCH" ] || die "$TASK has no branch in loop-state"
  read -r MAIN BASE < <("$STATE" repo "$REPO") || die "unknown repo '$REPO'"
  [ -d "$MAIN" ] && [ -n "$BASE" ] || die "no main checkout for $REPO"
}

fetch_refs() {
  git -C "$MAIN" fetch -q origin "+refs/heads/$BASE:refs/remotes/origin/$BASE" "+refs/heads/$BRANCH:refs/remotes/origin/$BRANCH" \
    || die "could not fetch $BASE and $BRANCH: is $BRANCH pushed?"
}

patch_of_branch() {
  local fork
  fork=$(git -C "$MAIN" merge-base "refs/remotes/origin/$BASE" "refs/remotes/origin/$BRANCH") || die "$BRANCH shares no history with $BASE"
  git -C "$MAIN" diff "$fork" "refs/remotes/origin/$BRANCH" | git patch-id --stable | cut -d' ' -f1
}

post_note() {
  local url rest host iid path host_var project
  url=$("$STATE" get "$TASK" mr) || url=""
  [ -n "$url" ] || { echo "loop-verdict: $TASK has no MR yet, the verdict is kept in loop-state only" >&2; return 0; }
  case "$url" in https://*/-/merge_requests/*) ;; *) die "loop-state mr is not a GitLab MR URL: $url" ;; esac
  rest="${url#https://}"
  host="${rest%%/*}"
  iid="${rest##*/merge_requests/}"
  path="${rest#*/}"
  path="${path%%/-/*}"
  host_var="LOOP_GLAB_REPO_$(echo "$REPO" | tr -c 'A-Za-z0-9\n' '_')"
  project="${!host_var:-$host/$path}"
  glab mr note create "$iid" -R "$project" --resolvable=false -m "$1" >/dev/null || die "could not post the verdict on MR !$iid"
}

record() {
  local verdict="$1" notes="$2" patch head status
  [ -s "$notes" ] || die "$notes is missing or empty: a verdict needs the checks it rests on"
  fetch_refs
  patch=$(patch_of_branch)
  [ -n "$patch" ] || die "$BRANCH has no diff against $BASE"
  head=$(git -C "$MAIN" rev-parse --short "refs/remotes/origin/$BRANCH")
  status=$("$STATE" get "$TASK" status)
  post_note "**Loop verdict: $verdict** · head \`$head\` · patch \`${patch:0:12}\`

$(cat "$notes")"
  "$STATE" set "$TASK" "$status" "verdict=$verdict" "verdict_patch=$patch" || die "could not write the verdict to loop-state"
  echo "$verdict $patch"
}

check() {
  local verdict patch
  verdict=$("$STATE" get "$TASK" verdict) || verdict=""
  [ -n "$verdict" ] || { echo none; return 0; }
  fetch_refs
  patch=$(patch_of_branch)
  if [ "$patch" = "$("$STATE" get "$TASK" verdict_patch)" ]; then echo "current $verdict"; else echo "stale $verdict"; fi
}

[ $# -ge 2 ] && [ $# -le 3 ] || usage
TASK="$1"
case "$TASK" in ""|*/*|.*|-*) die "bad task key '$TASK'" ;; esac
resolve_task
case "$2" in
  check) [ $# -eq 2 ] || usage; check ;;
  PASS|PASS+NOTES|FAIL) [ $# -eq 3 ] || usage; record "$2" "$3" ;;
  *) usage ;;
esac
