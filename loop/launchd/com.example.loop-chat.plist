<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.example.loop-chat</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/YOUR_USER/loop/bin/loop-chat</string>
		<string>poll</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/Users/YOUR_USER/loop/logs/launchd.log</string>
	<key>StandardOutPath</key>
	<string>/Users/YOUR_USER/loop/logs/launchd.log</string>
	<key>StartInterval</key>
	<integer>30</integer>
</dict>
</plist>
